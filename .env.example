# ==============================================================================
# KONFIGURASI DATABASE MYSQL (SiMantap)
# ==============================================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=simantap_db
DB_PORT=3306

# ==============================================================================
# KONFIGURASI SUPABASE (Hanya untuk Auth Login Session)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# KONFIGURASI CLOUDFLARE TURNSTILE (CAPTCHA)
# Dapatkan dari Cloudflare Dashboard -> Turnstile -> Add Widget (Domain: simantap.cloud)
# Jika belum diisi, sistem otomatis memakai testing key (muncul tulisan "for testing only")
# ==============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
