# ==============================================================================
# KONFIGURASI DATABASE MYSQL (SiMantap)
# ==============================================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=simantap_db
DB_PORT=3306

# ==============================================================================
# KONFIGURASI SUPABASE (Hanya untuk Auth Login Session)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# KONFIGURASI CLOUDFLARE TURNSTILE (CAPTCHA)
# Dapatkan dari Cloudflare Dashboard -> Turnstile -> Add Widget (Domain: simantap.cloud)
# Jika belum diisi, sistem otomatis memakai testing key (muncul tulisan "for testing only")
# ==============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...


# ==============================================================================
# PANDUAN MULTI-API KEY GROQ (FAILOVER & FALLBACK ANTI-LIMIT):
# 1. GROQ_API_KEY   : Kunci API utama (Wajib diisi).
# 2. GROQ_API_KEY_2 : Kunci API cadangan ke-2 (Opsional).
# 3. GROQ_API_KEY_3 : Kunci API cadangan ke-3 (Opsional).
#
# BAGAIMANA JIKA BELUM MEMILIKI KUNCI KE-2 ATAU KE-3?
# - Cukup dikosongkan (contoh: GROQ_API_KEY_2=) atau diisi tanda strip (contoh: GROQ_API_KEY_2=-).
# - Sistem otomatis mendeteksi dan hanya memakai kunci yang aktif & valid.
#
# BAGAIMANA JIKA INGIN MENAMBAH KUNCI KE-4, KE-5, DST?
# - Cukup tambahkan baris baru ke bawah:
#   GROQ_API_KEY_4=gsk_...
#   GROQ_API_KEY_5=gsk_...
# - Sistem otomatis membaca semua kunci yang diawali dengan GROQ_API_KEY_!
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
DB_HOST_AI=localhost
DB_USER_AI=root
DB_PASS_AI=
DB_NAME_AI=simantap_cld_db
